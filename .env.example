# ============================================================================
# AssociateVoiceMatters — Environment Template
# Copy to .env.local and fill in values. Never commit .env.local.
# ============================================================================

# ---- Database (standalone — not shared with TalkAIQ) ----
DATABASE_URL="postgresql://user:password@localhost:5432/avm?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/avm?schema=public"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ---- Email (magic link provider) ----
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="no-reply@associatevoicematters.com"

# ---- Identity Encryption ----
# 32-byte hex key for PII column encryption (email_hash, npi_hash, real_name)
IDENTITY_ENCRYPTION_KEY=""
# Separate pepper for hashing identifiers (email, NPI) into deterministic lookup keys
IDENTITY_HASH_PEPPER=""

# ---- Anthropic (Claude API) ----
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ---- Upstash Redis (sessions, rate limit, comp cache) ----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Cloudflare R2 (verification artifacts) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="avm-artifacts"

# ---- Future TalkAIQ Bridge (inactive at launch) ----
# Leave blank until bridge phase. All cross-platform traffic is API-only.
TALKAIQ_BRIDGE_URL=""
TALKAIQ_BRIDGE_API_KEY=""
TALKAIQ_BRIDGE_ENABLED="false"
