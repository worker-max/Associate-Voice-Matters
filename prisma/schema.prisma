// ============================================================================
//  AssociateVoiceMatters — Prisma Schema
//
//  Independent platform. Future API-only bridge to TalkAIQ.com.
//
//  Identity Bridge Security (seed §4.2) — non-negotiable:
//    • AssociateIdentity holds PII (email_hash, npi_hash, real_name, etc.).
//    • MarketRate carries NO foreign key to Associate — market aggregates and
//      PII never join at the schema level.
//    • IdentityUnlockEvent is append-only; every reveal is audited.
//    • TalkAIQ partner/consent flags are wired now, inactive at launch.
//
//  Engine: PostgreSQL (standalone — not shared with TalkAIQ).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
//  NextAuth tables (required by @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  associate Associate?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
//  Associate — the person. ONLY carries non-identifying attributes.
//  PII lives exclusively in AssociateIdentity.
// ---------------------------------------------------------------------------

enum IdentityStatus {
  ANONYMOUS
  VERIFIED
  UNLOCKED
}

enum Industry {
  HEALTHCARE
  HOSPITALITY
  RETAIL
  HOME_SERVICES
  EDUCATION
  OTHER
}

model Associate {
  id             String         @id @default(cuid())
  userId         String         @unique
  industry       Industry       @default(HEALTHCARE)
  identityStatus IdentityStatus @default(ANONYMOUS)

  // Future TalkAIQ bridge — wired, inactive at launch.
  bridgeConsentFlag Boolean @default(false)
  externalId        String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity     AssociateIdentity?
  cases        Case[]
  placements   Placement[]
  unlockEvents IdentityUnlockEvent[]
  compRecords  CompensationRecord[]

  @@index([industry])
  @@map("associates")
}

// ---------------------------------------------------------------------------
//  AssociateIdentity — PII vault. Never joined to aggregates.
//
//  email_hash / npi_hash are deterministic HMAC-SHA256(pepper, value) so we
//  can look up by identifier without storing plaintext. real_name is
//  AEAD-encrypted with IDENTITY_ENCRYPTION_KEY.
// ---------------------------------------------------------------------------

model AssociateIdentity {
  id          String  @id @default(cuid())
  associateId String  @unique
  emailHash   String  @unique
  npiHash     String? @unique
  npiVerified Boolean @default(false)
  npiVerifiedAt DateTime?
  realNameEnc String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@map("associate_identities")
}

// ---------------------------------------------------------------------------
//  IdentityUnlockEvent — append-only audit log.
//  Every reveal of identity to an employer/recruiter is recorded with
//  timestamp, reason, and the associate's consent record.
// ---------------------------------------------------------------------------

enum UnlockReason {
  ADVOCACY_RECOMMENDED
  ASSOCIATE_INITIATED
  PLACEMENT_REQUIRED
  VERIFICATION
}

model IdentityUnlockEvent {
  id           String       @id @default(cuid())
  associateId  String
  caseId       String?
  reason       UnlockReason
  consentHash  String
  initiatedBy  String       // "associate" | "ai-recommendation"
  createdAt    DateTime     @default(now())

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  case      Case?     @relation(fields: [caseId], references: [id])

  @@index([associateId, createdAt])
  @@map("identity_unlock_events")
}

// ---------------------------------------------------------------------------
//  Employer — can be a TalkAIQ partner (future) or not (all at launch).
// ---------------------------------------------------------------------------

model Employer {
  id       String    @id @default(cuid())
  name     String
  industry Industry  @default(HEALTHCARE)
  domain   String?   @unique

  // Future TalkAIQ bridge — wired, all false at launch.
  talkaiqPartnerFlag Boolean @default(false)
  talkaiqEmployerId  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations  EmployerLocation[]
  cases      Case[]
  placements Placement[]

  @@map("employers")
}

model EmployerLocation {
  id          String   @id @default(cuid())
  employerId  String
  label       String
  city        String?
  region      String?
  facilityType String?
  createdAt   DateTime @default(now())

  employer Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@map("employer_locations")
}

// ---------------------------------------------------------------------------
//  Case — a unit of voice. Always on one wing.
// ---------------------------------------------------------------------------

enum Wing {
  CHANNEL
  ENVOY
}

enum CaseStatus {
  OPEN
  AWAITING_EMPLOYER
  AWAITING_ASSOCIATE
  RESOLVED
  CLOSED
}

model Case {
  id            String      @id @default(cuid())
  associateId   String
  employerId    String?
  wing          Wing
  status        CaseStatus  @default(OPEN)
  anonymousFlag Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  associate    Associate             @relation(fields: [associateId], references: [id], onDelete: Cascade)
  employer     Employer?             @relation(fields: [employerId], references: [id])
  feedback     Feedback[]
  unlockEvents IdentityUnlockEvent[]

  @@index([associateId, status])
  @@index([employerId, wing, status])
  @@map("cases")
}

// ---------------------------------------------------------------------------
//  Feedback — raw intake + AI-structured output.
// ---------------------------------------------------------------------------

model Feedback {
  id             String   @id @default(cuid())
  caseId         String
  rawText        String   @db.Text
  structuredJson Json?
  aiTags         String[]
  confidence     Float?
  createdAt      DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("feedback")
}

// ---------------------------------------------------------------------------
//  CompensationRecord — per-associate submitted data.
//  Feeds MarketRate aggregates via de-identified rollups.
//
//  IMPORTANT: this table has a FK to Associate. MarketRate does NOT.
//  Aggregate rollups must scrub associate_id before writing to MarketRate.
// ---------------------------------------------------------------------------

enum RateType {
  HOURLY
  UNIT
  SALARY
  STIPEND
  MILEAGE
}

model CompensationRecord {
  id           String   @id @default(cuid())
  associateId  String
  role         String
  region       String
  facilityType String?
  rate         Decimal  @db.Decimal(12, 4)
  rateType     RateType
  ptoDays      Int?
  housingStipend Decimal? @db.Decimal(12, 2)
  travelAllowance Decimal? @db.Decimal(12, 2)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  associate Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([role, region, rateType])
  @@map("compensation_records")
}

// ---------------------------------------------------------------------------
//  MarketRate — de-identified aggregate benchmarks.
//  NO foreign key to Associate — enforced at the schema level.
// ---------------------------------------------------------------------------

model MarketRate {
  id           String   @id @default(cuid())
  role         String
  region       String
  facilityType String?
  rateType     RateType
  p25          Decimal  @db.Decimal(12, 4)
  p50          Decimal  @db.Decimal(12, 4)
  p75          Decimal  @db.Decimal(12, 4)
  sampleSize   Int
  updatedAt    DateTime @updatedAt

  @@unique([role, region, facilityType, rateType])
  @@index([role, region])
  @@map("market_rates")
}

// ---------------------------------------------------------------------------
//  Placement — dual channel (recruiter pass-through + direct).
// ---------------------------------------------------------------------------

enum PlacementChannel {
  RECRUITER
  DIRECT
}

enum PlacementStatus {
  INTRODUCED
  INTERVIEWING
  OFFERED
  PLACED
  WITHDRAWN
}

model Placement {
  id           String            @id @default(cuid())
  associateId  String
  employerId   String
  recruiterId  String?
  channel      PlacementChannel
  status       PlacementStatus   @default(INTRODUCED)
  feePct       Decimal           @db.Decimal(5, 2)
  firstYearSalary Decimal?       @db.Decimal(12, 2)
  introducedAt DateTime          @default(now())
  placedAt     DateTime?
  // 12-month NPI-anchored protection window (healthcare launch).
  protectionUntil DateTime?

  associate Associate  @relation(fields: [associateId], references: [id], onDelete: Cascade)
  employer  Employer   @relation(fields: [employerId], references: [id])
  recruiter Recruiter? @relation(fields: [recruiterId], references: [id])

  @@index([associateId, status])
  @@index([employerId, status])
  @@map("placements")
}

model Recruiter {
  id        String   @id @default(cuid())
  agency    String
  contact   String?
  splitPct  Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now())

  placements Placement[]

  @@map("recruiters")
}

// ---------------------------------------------------------------------------
//  SurveyResponse — vertical-targeted pulse surveys on landing pages.
//
//  Questions live in /src/content/surveys/* (editable code, no migration
//  needed). This table stores selections + numeric/text values + grid rows.
//  Dedup is (vertical, questionSlug, gridKey, ballotHash) — gridKey is null
//  for non-grid questions.
//
//  The optionKey column is used by single_choice questions; numericValue by
//  numeric questions; textValue by free_text questions. Exactly one is
//  populated per row.
// ---------------------------------------------------------------------------

model SurveyResponse {
  id           String   @id @default(cuid())
  vertical     String   // "home-health" | "home-hospice" | future verticals
  questionSlug String
  // For grid_numeric this is the row key; for all other question types it's
  // the empty string. Kept non-null so the composite unique constraint
  // actually dedupes on Postgres (NULLs would be treated as distinct).
  gridKey      String   @default("")
  optionKey    String?  // for single_choice
  numericValue Decimal? @db.Decimal(14, 4) // for numeric + grid_numeric
  textValue    String?  @db.Text // reserved; free_text lives in FreeTextFeedback
  ballotHash   String   // HMAC(pepper, anonymous cookie uuid) — not PII
  associateId  String?  // set only when a signed-in associate answers
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([vertical, questionSlug, gridKey, ballotHash])
  @@index([vertical, questionSlug])
  @@map("survey_responses")
}

// ---------------------------------------------------------------------------
//  BallotProfile — self-assigned identity for a ballot within a vertical.
//
//  Username is generated deterministically from ballotHash so it survives
//  re-visits. Discipline + agency are self-reported and optional at first
//  interaction. One profile per (ballotHash, vertical).
// ---------------------------------------------------------------------------

model BallotProfile {
  id           String   @id @default(cuid())
  ballotHash   String
  vertical     String
  username     String
  discipline   String?  // RN | LPN | PT | ... | OTHER
  agencyKey    String?  // slug from the alphabetized agency registry
  agencyWritein String? // free-text when "other" is chosen
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ballotHash, vertical])
  @@index([vertical, discipline])
  @@index([vertical, agencyKey])
  @@map("ballot_profiles")
}

// ---------------------------------------------------------------------------
//  FreeTextFeedback — long-form input on the vertical landing pages.
//
//  Two kinds:
//    • "general"        — "anything the clinician wants to share"
//    • "question-suggestion" — recommended future survey questions
//
//  No PII guardrail here (the text is free-form), so AI moderation /
//  PII-scrub should run before this gets surfaced on employer-facing views.
//  For Phase 1 this is append-only and associate-scoped for the author only.
// ---------------------------------------------------------------------------

model FreeTextFeedback {
  id          String   @id @default(cuid())
  vertical    String
  kind        String   // "general" | "question-suggestion"
  text        String   @db.Text
  agencyKey   String?
  agencyWritein String?
  discipline  String?
  username    String?  // snapshot of BallotProfile.username at write time
  ballotHash  String
  associateId String?
  createdAt   DateTime @default(now())

  @@index([vertical, kind, createdAt])
  @@index([ballotHash])
  @@map("free_text_feedback")
}
